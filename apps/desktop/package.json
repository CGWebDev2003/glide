{
  "name": "@glide/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Glide als Desktop-App",
  "author": "Glide",
  "main": "main.cjs",
  "scripts": {
    "build": "node scripts/prepare-server.mjs",
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.glide.desktop",
    "productName": "Glide",
    "executableName": "glide",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": "."
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video"
    }
  }
}
