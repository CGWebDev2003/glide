{
  "name": "scrollreel",
  "version": "0.1.0",
  "description": "Deterministic, frame-by-frame scroll video recorder for websites (virtual time + Playwright + ffmpeg).",
  "type": "module",
  "bin": {
    "scrollreel": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:site": "tsx test/serve.ts",
    "test:e2e": "tsx test/e2e.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "playwright": "^1.56.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
