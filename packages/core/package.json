{
  "name": "@glide/core",
  "version": "0.3.0",
  "private": true,
  "description": "Deterministic, frame-by-frame scroll video recorder (virtual time + Playwright + ffmpeg).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./options": {
      "types": "./dist/options.d.ts",
      "default": "./dist/options.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:site": "tsx test/serve.ts",
    "test:e2e": "tsx test/e2e.ts"
  },
  "dependencies": {
    "playwright": "^1.56.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
